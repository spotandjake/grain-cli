{
  "name": "@grain/cli",
  "version": "0.7.2",
  "description": "A command line tool for the Grain language.",
  "license": "MIT",
  "tasks": {
    "grain": "deno run -P --config=./deno.json ./src/main.ts",
    "build": "deno compile -P --output ./dist/grain ./src/main.ts",
    "format": "deno fmt",
    "check-format": "deno fmt --check",
    "clean": "rm -f ./src/artifacts/*.cjs ./src/artifacts/*.exe"
  },
  "compile": {
    "include": [
      "src/artifacts/grainc.bc.cjs",
      "src/artifacts/graindoc.bc.cjs",
      "src/artifacts/grainformat.bc.cjs", 
      "src/artifacts/grainlsp.bc.cjs",
      "src/shims/fs.cjs",
      "src/stdlib/"
    ],
    "exclude": [],
    "permissions": {
      "read": true,
      "write": true,
      "run": true,
      "env": true
    }
  },
  "fmt": {
    "include": [
      "src/**/*.ts",
      "src/shims/fs.cjs"
    ],
    "exclude": ["src/artifacts/"]
  },
  "permissions": {
    "default": {
      "read": true,
      "write": true,
      "run": true,
      "env": true
    }
  },
  "imports": {
    "@grain/stdlib": "npm:@grain/stdlib@^0.7.2",
    "commander": "npm:commander@^14.0.3"
  },
  "exports": {
    "./grain": "./src/main.ts"
  },
  "bin": {
    "grain": "./src/main.ts"
  }
}
