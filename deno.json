{
  "name": "@grain/cli",
  "version": "0.7.2",
  "description": "A command line tool for the Grain language.",
  "license": "MIT",
  "tasks": {
    "shim": "deno run --allow-read --allow-write=./artifacts ./scripts/apply_shims.ts",
    "bundle": "deno compile -P --output ./dist/grain main.ts",
    "fmt": "deno fmt",
    "check-fmt": "deno fmt --check",
    "clean": "rm -f bin/*.exe bin/*.bc.js"
  },
  "compile": {
    "include": [
      "artifacts/grainc.bc.cjs",
      "artifacts/graindoc.bc.cjs",
      "artifacts/grainformat.bc.cjs", 
      "artifacts/grainlsp.bc.cjs",
      "shims/fs.cjs",
      "stdlib/"
    ],
    "exclude": [],
    "permissions": {
      "read": true,
      "write": true,
      "run": true,
      "env": true
    }
  },
  "imports": {
    "@grain/stdlib": "npm:@grain/stdlib@^0.7.2",
    "commander": "npm:commander@^14.0.3"
  },
  "exports": {
    "./grain": "./main.js"
  },
  "bin": {
    "grain": "./main.js"
  }
}
